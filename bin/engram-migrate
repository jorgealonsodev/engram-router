#!/usr/bin/env bash
#
# Move one repository's Engram memories from one instance to another.
#
# The manual procedure is eight steps and three of them are quietly dangerous:
# skipping the destination check pushes work data to a personal cloud, skipping
# the source unenroll leaves the project replicating to both, and following
# Engram's own "git add .engram/" hint commits the memories themselves.
#
# Order matters and is enforced here: verify, pull, export, import, verify
# again, enroll, push, unenroll, clean. Enrolling before importing would
# enroll a project with no observations and look like it worked. Pulling
# before exporting matters just as much: a source that never pulled its own
# cloud can hold less than that cloud does, and exporting only the local copy
# would leave the difference stranded on the old server.
#
# Run this from inside the repository being migrated, BEFORE a routing rule
# sends it to the destination instance: the shim exports ENGRAM_DATA_DIR
# unconditionally, so once the rule matches there is no way back to the source.
set -euo pipefail

SCRIPT_SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENGRAM_ROUTER_LIB_DIR="${ENGRAM_ROUTER_LIB_DIR:-$HOME/.local/lib/engram-router}"
CONFIG_DIR="${ENGRAM_ROUTER_CONFIG_DIR:-$HOME/.config/engram-router}"
CONFIG_FILE="$CONFIG_DIR/router.json"

FROM=""; TO=""; DRY_RUN=0; ASSUME_YES=0; KEEP_SOURCE=0; CLEAN_CHUNKS=0; SKIP_SOURCE_PULL=0

say()  { printf '  %s\n' "$*"; }
step() { printf '\n[%s] %s\n' "$1" "$2"; }
die()  { printf '\nABORTADO: %s\n' "$*" >&2; exit 1; }

usage() {
    cat <<'USAGE'
Uso: engram-migrate --from <instancia> --to <instancia> [opciones]

Ejecútelo DENTRO del repositorio que quiere migrar.

  --from <nombre>          Instancia origen (donde están hoy las memorias).
                           Si se omite y solo hay otra instancia, se deduce.
  --to <nombre>            Instancia destino. Si se omite, se toma de las
                           reglas de enrutado de este repositorio.
  --dry-run                Muestra el plan y no cambia nada.
  --keep-source-enrolled   No desenrola en origen (seguirá replicando allí).
  --clean-chunks           Borra los chunks exportados al terminar.
                           IRREVERSIBLE: el origen no los regenera, así que
                           esta migración ya no se podrá repetir.
  --skip-source-pull       Omite traer del cloud de origen antes de exportar.
                           ARRIESGADO: lo que solo exista en ese cloud no se
                           migrará y quedará huérfano allí.
  --yes                    No pedir confirmación.
USAGE
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --from) FROM="${2:-}"; shift 2 ;;
        --to)   TO="${2:-}";   shift 2 ;;
        --dry-run) DRY_RUN=1; shift ;;
        --keep-source-enrolled) KEEP_SOURCE=1; shift ;;
        --clean-chunks) CLEAN_CHUNKS=1; shift ;;
        --skip-source-pull) SKIP_SOURCE_PULL=1; shift ;;
        --yes|-y) ASSUME_YES=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *) printf 'Opción desconocida: %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
done

# --to defaults to whatever the routing rules say this repository belongs to,
# and --from to the only other configured instance. Both stop and ask rather
# than guess: with three instances "the other one" is not a single answer, and
# guessing wrong would migrate from an empty instance, count 0 against 0 and
# report success — the silent failure this tool exists to prevent.
#
# Both that inference and instance_data_dir() below need router.json parsed,
# so the shared library is loaded exactly once, here, rather than each of
# them re-implementing config parsing with sed of its own. A hand-rolled sed
# once returned a single name from a router.json written on one line —
# greedy matching kept only the last instance — and the caller then treated
# it as "the only other instance" and picked it. Silently choosing a source
# is the failure this inference exists to avoid, so it must not be
# reintroduced here. instance_data_dir()'s own former sed had the same
# one-line-only limitation for "data_dir", plus a separate $HOME/~ expansion
# sed whose delimiter (#) breaks outright if $HOME itself contains one.
# router.sh's router_load_config/router_expand_path have neither problem.
ROUTER_LIB_LOADED=0
ROUTER_CONFIG_LOADED=0
for _router_lib in "$ENGRAM_ROUTER_LIB_DIR/router.sh" "$HOME/.local/lib/engram-router/router.sh" \
                    "$SCRIPT_SELF_DIR/../lib/router.sh"; do
    [[ -r "$_router_lib" ]] || continue
    # shellcheck source=/dev/null
    source "$_router_lib"
    ROUTER_LIB_LOADED=1
    break
done
unset _router_lib

if [[ $ROUTER_LIB_LOADED -eq 1 && -r "$CONFIG_FILE" ]]; then
    router_load_config "$CONFIG_FILE" 2>/dev/null && ROUTER_CONFIG_LOADED=1
fi

list_instances() {
    [[ $ROUTER_CONFIG_LOADED -eq 1 ]] || return 1
    printf '%s\n' ${INSTANCE_NAMES[@]+"${INSTANCE_NAMES[@]}"}
}

if [[ -z "$TO" ]]; then
    # Gate on SOURCE, not on INSTANCE being non-empty. SOURCE says explicitly
    # whether the instance was resolved ("rule", "override") or defaulted
    # ("unmatched"); INSTANCE happens to be blank when unmatched today, but
    # that is an implementation detail of router_resolve, and the documented
    # behaviour is that an unmatched repository still gets a default instance
    # for local operations. Relying on the blank would let a repository that
    # matches no rule be migrated into the default — and a migration enrolls
    # the destination and unenrols the source, so there is nothing to undo.
    resolved="$("$SCRIPT_SELF_DIR/engram-router" resolve 2>/dev/null || true)"
    resolved_source="$(printf '%s' "$resolved" | sed -n 's/^SOURCE=//p' | head -1)"
    resolved_instance="$(printf '%s' "$resolved" | sed -n 's/^INSTANCE=//p' | head -1)"

    case "$resolved_source" in
        rule|override) : ;;
        *) die \
"no se ha indicado --to y este repositorio no resuelve a ninguna instancia
        (SOURCE=${resolved_source:-desconocido}). No se deduce un destino por
        defecto: la migración enrola el destino y desenrola el origen, así que
        un destino equivocado no se puede deshacer.
        Indique el destino:  engram-migrate --to <instancia>
        Para ver por qué no resuelve:  engram-where" ;;
    esac

    [[ -n "$resolved_instance" ]] || die \
"el resolver informa SOURCE=$resolved_source pero no da instancia. No se
        migra sin un destino explícito:  engram-migrate --to <instancia>"

    TO="$resolved_instance"
    say "destino deducido de las reglas: '$TO' (SOURCE=$resolved_source)"
fi

if [[ -z "$FROM" ]]; then
    local_others=()
    while IFS= read -r inst; do
        [[ -n "$inst" && "$inst" != "$TO" ]] && local_others+=("$inst")
    done < <(list_instances)

    case ${#local_others[@]} in
        1) FROM="${local_others[0]}"
           say "origen deducido: '$FROM' (la única otra instancia configurada)" ;;
        0) die "no hay ninguna otra instancia configurada desde la que migrar." ;;
        *) die \
"hay varias instancias posibles como origen: ${local_others[*]}
        Indique cuál con --from <instancia>. No se deduce: migrar desde la
        instancia equivocada exportaría cero memorias y la comprobación daría
        0 contra 0, informando de un éxito que no lo es." ;;
    esac
fi

[[ -n "$FROM" && -n "$TO" ]] || { usage >&2; exit 2; }
[[ "$FROM" != "$TO" ]] || die "origen y destino son la misma instancia ('$FROM')."

# The shim exports ENGRAM_DATA_DIR unconditionally, so every call below must
# reach the real binary directly or it would be redirected mid-migration.
resolve_real_engram() {
    # Walk PATH and take the first engram that is not the shim, identified by a
    # marker inside the file rather than by its directory. Stripping only the
    # caller's own directory was not enough: run from a clone before
    # installing, that leaves the installed shim first in PATH, and the shim
    # rewrites ENGRAM_DATA_DIR for the current repository — so a query about
    # one instance silently answered about another, or was refused outright.
    local entry candidate
    while IFS= read -r entry; do
        [[ -z "$entry" ]] && continue
        candidate="$entry/engram"
        [[ -x "$candidate" ]] || continue
        grep -q 'engram-router-shim' "$candidate" 2>/dev/null && continue
        printf '%s' "$candidate"
        return 0
    done < <(printf '%s' "${PATH:-}" | tr ':' '\n')
    return 1
}

REAL_ENGRAM="$(resolve_real_engram || true)"
[[ -n "$REAL_ENGRAM" ]] || die "no se encuentra el binario real de engram."

# Instance data dirs come from router.json; both must be configured. Uses
# the shared library's parser and its router_expand_path (loaded once above
# into ROUTER_CONFIG_LOADED / INSTANCE_DATA_DIR) instead of re-parsing
# router.json and re-expanding $HOME/~ with sed of its own — see the note
# above list_instances() for what that duplication used to break. Falls back
# to a line-based parse only when the shared library itself could not be
# found at all (a broken install, not a normal run); even then the $HOME/~
# expansion is plain bash parameter expansion, matching router_expand_path's
# own logic, never a sed substitution — a sed delimiter is exactly what broke
# here before.
instance_data_dir() {
    local name="$1"
    if [[ $ROUTER_CONFIG_LOADED -eq 1 ]]; then
        local dir="${INSTANCE_DATA_DIR[$name]:-}"
        [[ -n "$dir" ]] || return 1
        router_expand_path "$dir"
        return 0
    fi

    [[ -r "$CONFIG_FILE" ]] || return 1
    local raw
    raw="$(sed -n "s/.*\"$name\"[[:space:]]*:[[:space:]]*{[^}]*\"data_dir\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$CONFIG_FILE" | head -1)"
    [[ -n "$raw" ]] || return 1
    # shellcheck disable=SC2016,SC2088
    case "$raw" in
        '$HOME'/*) raw="${HOME}${raw#\$HOME}" ;;
        '~/'*) raw="${HOME}/${raw#\~/}" ;;
        '~') raw="${HOME}" ;;
    esac
    printf '%s\n' "$raw"
}

FROM_DIR="$(instance_data_dir "$FROM" || true)"
TO_DIR="$(instance_data_dir "$TO" || true)"
[[ -n "$FROM_DIR" ]] || die "la instancia '$FROM' no está en $CONFIG_FILE."
[[ -n "$TO_DIR"   ]] || die "la instancia '$TO' no está en $CONFIG_FILE."
[[ -d "$FROM_DIR" ]] || die "el directorio de datos de '$FROM' no existe: $FROM_DIR"
[[ -d "$TO_DIR"   ]] || die "el directorio de datos de '$TO' no existe: $TO_DIR"

# Reads a labelled line from Engram's output. Engram has no machine-readable
# status (`engram doctor --json` exists, `cloud status` has no equivalent), so
# this has to parse text meant for humans. The one thing that must not happen
# is mistaking "Engram no longer prints this label" for "the value is empty":
# the first is a format change and the second is a real configuration problem,
# and they need different messages. Absence is reported by returning 1.
read_label() {
    local text="$1" label="$2" line
    line="$(printf '%s' "$text" | sed -n "s/^${label}:[[:space:]]*//p" | head -1)"
    printf '%s' "$text" | grep -q "^${label}:" || return 1
    printf '%s' "$line"
}

# Engram's own project detection: git remote first, then directory name.
remote="$(git remote get-url origin 2>/dev/null || true)"
if [[ -n "$remote" ]]; then
    PROJECT="$(basename -s .git "$remote")"
else
    PROJECT="$(basename "$PWD")"
fi
[[ -n "$PROJECT" ]] || die "no se puede determinar el proyecto desde $PWD."

# Every call is environment-clean: a stray ENGRAM_CLOUD_* would override the
# instance's own cloud.json and silently send this data to the wrong server.
run_in() {
    local data_dir="$1"; shift
    env -u ENGRAM_CLOUD_SERVER -u ENGRAM_CLOUD_TOKEN -u ENGRAM_CLOUD_AUTOSYNC \
        ENGRAM_DATA_DIR="$data_dir" "$REAL_ENGRAM" "$@"
}

printf '\n=== Migración de "%s" ===\n' "$PROJECT"
say "origen:  $FROM  ($FROM_DIR)"
say "destino: $TO  ($TO_DIR)"
[[ $DRY_RUN -eq 1 ]] && say "MODO SIMULACIÓN: no se cambia nada."

# ---------------------------------------------------------------------------
# Step 0 — the destination must resolve from its own cloud.json. A polluted
# environment here means pushing this project to the wrong server.
# ---------------------------------------------------------------------------
step 0 "Verificando el destino"
dest_status="$(run_in "$TO_DIR" cloud status 2>&1 || true)"

if ! dest_source="$(read_label "$dest_status" 'Server source')"; then
    die "Engram no ha impreso 'Server source' al consultar el destino.
        O la consulta falló, o el formato de salida cambió en esta versión de
        Engram y este script ya no puede leerlo. No se ha movido nada.
        Compruebe a mano:  engram cloud status"
fi
dest_server="$(read_label "$dest_status" 'Server' || true)"

say "servidor: ${dest_server:-<ninguno>}"
say "origen del ajuste: ${dest_source:-<ninguno>}"

[[ "$dest_source" == "cloud.json" ]] || die \
"el destino resuelve desde '$dest_source', no desde su cloud.json.
        Con ENGRAM_CLOUD_* en el entorno, esta migración empujaría al servidor
        equivocado. Retire esas variables y vuelva a intentarlo."
[[ -n "$dest_server" ]] || die "el destino no tiene servidor configurado."

if [[ $ASSUME_YES -eq 0 && $DRY_RUN -eq 0 && -t 0 ]]; then
    read -r -p "  ¿Migrar '$PROJECT' a $dest_server? [s/N]: " a || true
    [[ "${a,,}" =~ ^(s|si|sí|y|yes)$ ]] || die "cancelado por el usuario."
fi

# ---------------------------------------------------------------------------
# Step 1 — pull the source's own cloud into it before exporting. Without
# this, only what already reached the source's local database gets exported;
# anything that lives solely on the source's cloud (from another machine, or
# a previous migration) is silently left behind. A source with no cloud.json
# has never had a cloud to fall behind, so that case proceeds instead of
# blocking a legitimate local-only migration; any other failure blocks.
# ---------------------------------------------------------------------------
step 1 "Trayendo del cloud de origen"
if [[ $DRY_RUN -eq 1 ]]; then
    say "(simulado) engram sync --import --cloud --project $PROJECT"
elif [[ ! -r "$FROM_DIR/cloud.json" ]]; then
    say "origen sin cloud.json: no hay nube de la que traer nada."
elif [[ $SKIP_SOURCE_PULL -eq 1 ]]; then
    say "AVISO: --skip-source-pull activo, no se comprueba el cloud de origen."
    say "       Lo que solo exista allí quedará huérfano, sin migrar."
else
    run_in "$FROM_DIR" sync --import --cloud --project "$PROJECT" 2>&1 | sed 's/^/  /' ||
        die "no se pudo traer del cloud de origen ('$FROM'): puede no estar
        enrolado, el servidor puede estar inaccesible, o el comando falló
        (vea la salida de arriba). No se ha exportado nada. Si de verdad no
        hace falta nada del cloud de origen, repita con --skip-source-pull."
fi

# ---------------------------------------------------------------------------
# Step 2 — export. Project-scoped: only this project leaves the source.
# ---------------------------------------------------------------------------
step 2 "Exportando desde '$FROM'"
if [[ $DRY_RUN -eq 1 ]]; then
    say "(simulado) engram sync"
else
    out="$(run_in "$FROM_DIR" sync 2>&1)"
    printf '%s\n' "$out" | sed 's/^/  /'
    [[ -d .engram/chunks ]] || die "el export no creó .engram/chunks/."
fi

# ---------------------------------------------------------------------------
# Step 3 and 4 — import, then check the counts agree before anything is
# pushed. Import is idempotent, so a re-run reports zero new chunks.
# ---------------------------------------------------------------------------
step 3 "Importando en '$TO'"
if [[ $DRY_RUN -eq 1 ]]; then
    say "(simulado) engram sync --import"
else
    out="$(run_in "$TO_DIR" sync --import 2>&1)"
    printf '%s\n' "$out" | sed 's/^/  /'
    imported="$(printf '%s' "$out" | sed -n 's/^[[:space:]]*Observations:[[:space:]]*//p' | head -1)"
    # Neither the count nor the "nothing new" phrase appearing means the output
    # no longer looks like Engram's. Said explicitly, because the fallback below
    # would otherwise report an empty import and blame the data.
    if [[ -z "$imported" ]] && ! printf '%s' "$out" | grep -q 'No new chunks to import'; then
        say "AVISO: la salida del import no contiene ni un recuento de observaciones"
        say "       ni el mensaje de 'nada nuevo'. Puede que el formato de Engram"
        say "       haya cambiado; la comprobación por base de datos sigue siendo fiable."
    fi
    printf '%s' "$out" | grep -q 'No new chunks to import' &&
        say "ya estaba importado (reejecución): se continúa."

    step 4 "Comprobando las cuentas"
    # Count what a project-scoped export actually carries, which is narrower
    # than "every row of this project" in two ways, each of which produced a
    # false abort before it was accounted for:
    #   - soft-deleted rows are exported but not materialized (1147 vs 1139)
    #   - scope='personal' rows belong to the user, not the project, so they
    #     stay behind by design (148 vs 147)
    # Comparing live project-scoped rows on both sides matches the export.
    if command -v sqlite3 >/dev/null 2>&1; then
        src_live="$(sqlite3 "$FROM_DIR/engram.db" \
            "SELECT COUNT(*) FROM observations WHERE LOWER(project)=LOWER('$PROJECT') AND deleted_at IS NULL AND scope='project';" 2>/dev/null || echo "")"
        dst_live="$(sqlite3 "$TO_DIR/engram.db" \
            "SELECT COUNT(*) FROM observations WHERE LOWER(project)=LOWER('$PROJECT') AND deleted_at IS NULL AND scope='project';" 2>/dev/null || echo "")"
        if [[ -n "$src_live" && -n "$dst_live" ]]; then
            say "de proyecto en origen: $src_live · en destino: $dst_live"
            [[ "$dst_live" -ge "$src_live" ]] || die \
"faltan observaciones de proyecto en el destino ($dst_live de $src_live).
        No se ha enrolado ni empujado nada. El origen está intacto."
        else
            say "no se pudieron leer las bases de datos: se omite el conteo exacto."
        fi
    else
        say "sqlite3 no disponible: se omite el conteo exacto."
        printf '%s' "$out" | grep -q 'No new chunks to import' ||
            [[ "${imported:-0}" -gt 0 ]] ||
            die "el import no trajo observaciones. El origen está intacto."
    fi
fi

# ---------------------------------------------------------------------------
# Step 5 and 6 — enroll only now that the data is there, then push.
# ---------------------------------------------------------------------------
step 5 "Enrolando '$PROJECT' en '$TO'"
if [[ $DRY_RUN -eq 1 ]]; then
    say "(simulado) engram cloud enroll $PROJECT"
else
    run_in "$TO_DIR" cloud enroll "$PROJECT" 2>&1 | sed 's/^/  /' || true
fi

step 6 "Empujando a $dest_server"
if [[ $DRY_RUN -eq 1 ]]; then
    say "(simulado) engram sync --cloud --project $PROJECT"
else
    run_in "$TO_DIR" sync --cloud --project "$PROJECT" 2>&1 | sed 's/^/  /' ||
        die "el push falló. El proyecto ya está importado y enrolado en '$TO';
        corrija el problema y vuelva a ejecutar (el import es idempotente)."
fi

# ---------------------------------------------------------------------------
# Step 7 — stop the source replicating. Last on purpose: until the push
# succeeded, the source copy was the only one reaching a cloud.
# ---------------------------------------------------------------------------
step 7 "Desenrolando '$PROJECT' en '$FROM'"
if [[ $KEEP_SOURCE -eq 1 ]]; then
    say "omitido por --keep-source-enrolled: seguirá replicando en '$FROM'."
elif [[ $DRY_RUN -eq 1 ]]; then
    say "(simulado) engram cloud unenroll $PROJECT"
else
    run_in "$FROM_DIR" cloud unenroll "$PROJECT" 2>&1 | sed 's/^/  /' || true
    say "las memorias siguen en '$FROM'; solo deja de replicarlas."
fi

# ---------------------------------------------------------------------------
# Step 8 — the chunks are memories in portable form and Engram suggests
# committing them, which would publish their contents to everyone with
# repository access. Ignore them; do NOT delete them.
#
# Deleting makes the migration unrepeatable. The source records every chunk it
# ever produced in sync_chunks and will not regenerate one: a re-run reports
# "Nothing new to sync" while the destination stays empty. The only way back is
# `engram sync --all`, which exports every project at once — measured at 6594
# observations where one project needed 1139.
# ---------------------------------------------------------------------------
step 8 "Protegiendo los chunks exportados"
if [[ $DRY_RUN -eq 1 ]]; then
    say "(simulado) añadir .engram/chunks/ a .gitignore"
elif [[ $CLEAN_CHUNKS -eq 1 ]]; then
    rm -rf .engram/chunks .engram/manifest.json
    say "borrados por --clean-chunks."
    say "ATENCIÓN: esta migración ya no se puede repetir para '$PROJECT'."
else
    gi=".gitignore"
    if ! { [[ -f "$gi" ]] && grep -qE '^\.engram/chunks/?$' "$gi"; }; then
        # Read the size before opening the file for append, not inside it.
        needs_blank=0
        [[ -s "$gi" ]] && needs_blank=1
        { [[ $needs_blank -eq 1 ]] && printf '\n'
          printf '# Engram memories in portable form — never commit these.\n.engram/chunks/\n'
        } >> "$gi"
        say "añadido '.engram/chunks/' a $gi"
    else
        say "'.engram/chunks/' ya estaba en $gi"
    fi
    say "los chunks se conservan: borrarlos impediría repetir esta migración."
fi

printf '\n=== Hecho ===\n'
say "'$PROJECT' está ahora en '$TO' y replica a $dest_server."
[[ $KEEP_SOURCE -eq 0 ]] && say "Las memorias antiguas siguen en '$FROM' y en el cloud al que ya se subieron."
say "Lo ya replicado a un cloud anterior NO se borra: eso es una decisión suya."
[[ $CLEAN_CHUNKS -eq 0 ]] && say "Los chunks quedan en .engram/chunks/, ignorados por git."
