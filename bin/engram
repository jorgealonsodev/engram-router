#!/usr/bin/env bash
# bin/engram — PATH shim that routes Engram operations to the correct
# ENGRAM_DATA_DIR for the current repository, then execs the real binary.
#
# Failure mode is silence, never misdirection (per the feature spec):
#   - Local operations always pass through, routed or not.
#   - Cloud operations (sync, cloud ...) are REFUSED when routing is
#     unresolved, rather than silently running against a default/wrong
#     instance.
#
# This shim only ever selects ENGRAM_DATA_DIR. It never reads, writes,
# passes, or logs a token — credentials stay entirely inside each
# instance's own cloud.json, resolved by the real engram binary itself.
set -euo pipefail

ROUTER_CONFIG="${ENGRAM_ROUTER_CONFIG:-$HOME/.config/engram-router/router.json}"

_self_dir() {
    cd "$(dirname "${BASH_SOURCE[0]}")" && pwd
}

# Locate lib/router.sh: prefer the installed support location, fall back to
# the sibling ../lib layout used in this source tree / repo checkout.
_find_router_lib() {
    local self_dir installed_lib sibling_lib
    self_dir="$(_self_dir)"
    installed_lib="${ENGRAM_ROUTER_LIB:-$HOME/.local/lib/engram-router/router.sh}"
    sibling_lib="$self_dir/../lib/router.sh"
    if [[ -r "$installed_lib" ]]; then
        printf '%s\n' "$installed_lib"
    elif [[ -r "$sibling_lib" ]]; then
        printf '%s\n' "$sibling_lib"
    else
        return 1
    fi
}

# Resolve the real engram binary WITHOUT recursing into this shim: strip
# this shim's own directory from PATH and search again. Never hardcode a
# specific install path (e.g. Homebrew's) — it must work on any machine.
_find_real_engram() {
    local self_dir dir
    self_dir="$(_self_dir)"
    local IFS=:
    for dir in $PATH; do
        [[ -z "$dir" ]] && continue
        [[ "$dir" == "$self_dir" ]] && continue
        if [[ -x "$dir/engram" ]]; then
            printf '%s\n' "$dir/engram"
            return 0
        fi
    done
    return 1
}

main() {
    local real_engram router_lib
    if ! real_engram="$(_find_real_engram)"; then
        echo "engram: no se encontró el binario real de engram en el PATH (fuera de este shim)." >&2
        exit 127
    fi

    if router_lib="$(_find_router_lib)"; then
        # shellcheck source=/dev/null
        source "$router_lib"
    fi

    local repo_dir
    repo_dir="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

    local resolved=0
    if declare -F router_resolve >/dev/null && [[ -r "$ROUTER_CONFIG" ]]; then
        if router_resolve "$repo_dir" "$ROUTER_CONFIG" 2>/dev/null; then
            resolved=1
        fi
    fi

    local subcmd="${1:-}"
    local is_cloud_op=0
    if declare -F router_is_cloud_op >/dev/null && [[ -n "$subcmd" ]] && router_is_cloud_op "$subcmd"; then
        is_cloud_op=1
    fi

    if [[ $resolved -eq 1 && -n "${ROUTER_INSTANCE:-}" && -n "${ROUTER_DATA_DIR:-}" ]]; then
        export ENGRAM_DATA_DIR="$ROUTER_DATA_DIR"
    elif [[ $is_cloud_op -eq 1 ]]; then
        cat >&2 <<EOF
engram: operación de nube rechazada — este repositorio no está enrutado a
ninguna instancia de Engram.

  repo: $repo_dir

Esto ocurre porque no hay una regla de enrutamiento que coincida con el
remoto de este repositorio (o el repositorio no tiene remoto), y tampoco
hay un override "instance" en .engram/config.json.

Cómo resolverlo:
  1. Añade una regla en $ROUTER_CONFIG que cubra el host/propietario de
     este remoto, o
  2. Añade "instance": "<nombre>" a .engram/config.json de este repositorio.

Las operaciones locales de engram siguen funcionando con normalidad; solo
se rechazan las operaciones de nube (sync, cloud ...) para evitar
replicar datos al servidor equivocado.
EOF
        exit 1
    fi
    # Unresolved + local operation: pass through untouched, against
    # whatever ENGRAM_DATA_DIR/default the real binary already uses.

    exec "$real_engram" "$@"
}

main "$@"
